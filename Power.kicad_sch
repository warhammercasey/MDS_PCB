	)
	(text "PWR LEDs"
		(exclude_from_sim no)
		(at 95.25 102.362 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4f7d2428-51e1-4204-9c83-8ee0150d1b65")
	)
	(text "Power estimator gives ~1.7W at 75% utilization, 300MHz, and 50% activity.\nCore power supply will be designed for 2A@1.2V.\nThe T20 datasheet specifies +/- 50mV tolerance on VCC so ripple is a priority here.\nIO power supply can probably get away with a LDO - TODO check this\nT20 datasheet recommends bringing VCCIO up AFTER VCC.\n	VCCIO rail is brought up with an enable pin from the PGOOD signal of VCC"
		(exclude_from_sim no)
		(at 40.386 44.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5f3c8c71-b98a-4325-bd89-52d237de1242")
	)
	(text "1.2V Core Regulator"
		(exclude_from_sim no)
		(at 40.386 53.34 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7a4e3e27-1338-4820-bc0c-7d5c1b4a3d71")
	)
	(text "Power supply switch, prioritizes USB 5V.\nWhen USB drops below 4V, switches to VIN.\nPR1 reference voltage is 1V.\nST is pulled low when VBUS is not in use.\n	Indicator LED will turn on when USB 5V is available.\nFrom datasheet - switchover time is 8us.\n	C out should smooth that out.\n	Assuming current draw of 1.2A and min safe voltage of 4.5V\n	(5V - 4.5V)*C/1.2A = 8us\n	C = 12.2uF Round up to 22uF"
		(exclude_from_sim no)
		(at 158.75 72.644 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bedcac6a-b87b-40b9-b4e2-d6c5c3640c0a")
	)
	(text "3.3V IO Regulator"
		(exclude_from_sim no)
		(at 40.64 101.854 0)
		(effects
