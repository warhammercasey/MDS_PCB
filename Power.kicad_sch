	(text "Power estimator gives ~1.7W at 75% utilization, 300MHz, and 50% activity.\nCore power supply will be designed for 2A@1.2V.\nThe T13 datasheet specifies +/- 50mV tolerance on VCC so ripple is a priority here.\nIO power supply can probably get away with a LDO - TODO check this\nT13 datasheet recommends bringing VCCIO up AFTER VCC"
		(exclude_from_sim no)
		(at 42.672 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5f3c8c71-b98a-4325-bd89-52d237de1242")
	)
	(text "Power supply switch, prioritizes USB 5V.\nWhen USB drops below 4V, switches to VIN.\nPR1 reference voltage is 1V.\nST is pulled low when VBUS is not in use.\n	Indicator LED will turn on when USB 5V is available."
		(exclude_from_sim no)
		(at 205.994 99.822 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bedcac6a-b87b-40b9-b4e2-d6c5c3640c0a")
	)
