	(text "SPI interface for programming FLASH.\nNote the FPGA RESETN and HOLD signals are included in this bus.\n	Efinix software expects them to be here and uses them for both \n	FLASH programming and JTAG programming."
		(exclude_from_sim no)
		(at 192.532 61.976 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "216b0f43-2739-4360-922d-cb8912eeb8e2")
	)
	(text "UART is seen as VCP on host computer and goes to FPGA GPIO.\nCan be used to control FPGA from host."
		(exclude_from_sim no)
		(at 192.278 111.506 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "69c5f017-2cfb-4128-9c62-a5e43a9a3f7e")
	)
	(text "JTAG interface for programming FPGA.\nThis interface also uses the RESETN and HOLD signals from channel A"
		(exclude_from_sim no)
		(at 192.278 85.598 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "72d740bf-8d57-440c-9877-f4c9278d8757")
	)
	(text "Bit-bang interface. Might be able to do high-speed data transfer with custom host driver.\nTODO: Do these need to be differential pairs? \n	Im not sure what datarates bit-bang mode can handle."
		(exclude_from_sim no)
		(at 191.262 135.636 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a68dc0f7-6bfb-4c92-832d-4b314ae1f8ec")
	)
